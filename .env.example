# Copy this file to .env and adjust the values for your local environment.
# None of these variables hold real secrets.

APP_NAME=agentic-learning-platform
APP_ENV=local
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database (PostgreSQL + pgvector) ---
# "localhost" works when running the app or tests directly on the host,
# against docker-compose's published port 5432. The `api` container itself
# overrides this to "postgres" via docker-compose.yml — do not change this
# value to "postgres" here, it would break host-side `make run`/`pytest`.
DB_HOST=localhost
DB_PORT=5432
DB_USER=agentic_learning
DB_PASSWORD=agentic_learning
DB_NAME=agentic_learning
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# --- Execution mode ---
# "local": FastEmbed (multilingual, in-process) + extractive answers, no AWS needed.
# "aws": AWS Bedrock embeddings + AWS Bedrock (ChatBedrockConverse) generation.
RUNTIME_MODE=local

# Must match the vector column dimension of the database in use. The app
# fails fast at startup if this does not match what was recorded when the
# schema was migrated (see docs/architecture.md).
EMBEDDING_DIMENSION=384

# --- Local mode (RUNTIME_MODE=local) ---
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Relative path, correct for host-side pytest/make run. The `api` container
# overrides this to /app/.cache/fastembed via docker-compose.yml — do not
# change this value here, it would break host-side runs.
FASTEMBED_CACHE_DIR=.cache/fastembed

# --- AWS mode (RUNTIME_MODE=aws) ---
AWS_REGION=us-east-1
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
# When RUNTIME_MODE=aws, set EMBEDDING_DIMENSION=1024 (Titan V2 default) and
# re-run the migration against a fresh database — see docs/architecture.md.

# --- Ingestion / retrieval ---
MAX_UPLOAD_SIZE_MB=20
CHUNK_MAX_CHARS=1200
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.35
