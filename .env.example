# Copy this file to .env and adjust the values for your local environment.
# None of these variables hold real secrets.

APP_NAME=agentic-learning-platform
APP_ENV=local
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database (PostgreSQL + pgvector) ---
# "localhost" works when running the app or tests directly on the host,
# against docker-compose's published port 5432. The `api` container itself
# overrides this to "postgres" via docker-compose.yml — do not change this
# value to "postgres" here, it would break host-side `make run`/`pytest`.
DB_HOST=localhost
DB_PORT=5432
DB_USER=agentic_learning
DB_PASSWORD=agentic_learning
DB_NAME=agentic_learning
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# --- Execution mode ---
# "local": FastEmbed (multilingual, in-process) + extractive answers, no AWS needed.
# "aws": AWS Bedrock embeddings + AWS Bedrock (ChatBedrockConverse) generation.
RUNTIME_MODE=local

# Must match the vector column dimension of the database in use. The app
# fails fast at startup if this does not match what was recorded when the
# schema was migrated (see docs/architecture.md).
EMBEDDING_DIMENSION=384

# --- Local mode (RUNTIME_MODE=local) ---
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Relative path, correct for host-side pytest/make run. The `api` container
# overrides this to /app/.cache/fastembed via docker-compose.yml — do not
# change this value here, it would break host-side runs.
FASTEMBED_CACHE_DIR=.cache/fastembed

# --- AWS mode (RUNTIME_MODE=aws) ---
# Credentials: the standard AWS SDK credential chain (AWS_PROFILE / SSO for
# local development, an IAM task role in a future ECS deployment) — never a
# static access key here or anywhere else in this repo.
AWS_REGION=us-east-1
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_MAX_OUTPUT_TOKENS=1024
BEDROCK_GENERATION_TIMEOUT_SECONDS=30
BEDROCK_MAX_RETRIES=3
# Required when RUNTIME_MODE=aws — private bucket for source-document
# storage (PR-008). The app fails fast at startup if this is unset.
S3_BUCKET=
# When RUNTIME_MODE=aws, set EMBEDDING_DIMENSION to 256, 512, or 1024 (the
# only values Titan Embed Text V2 accepts — the app fails fast at startup
# otherwise) and re-run the migration against a fresh, AWS-only database —
# never the same database local mode's 384-dimension schema already uses.
# See docs/architecture.md's PR-008 section.

# --- Ingestion / retrieval ---
MAX_UPLOAD_SIZE_MB=20
CHUNK_MAX_CHARS=1200
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.35

# --- Query input limits (shared by /v1/query and /v1/query/stream) ---
MAX_QUESTION_LENGTH=2000

# --- Streaming (PR-003; real Bedrock streaming added in PR-008) ---
# Local-mode-only word-by-word pacing delay for /v1/query/stream
# (ExtractiveAnswerGeneratorAdapter has no real incremental generation
# latency of its own). Never applied to AWS-mode chunks — real Bedrock
# token latency is the pacing there. See docs/architecture.md.
STREAM_CHUNK_DELAY_MS=40

# --- CORS ---
# Comma-separated, explicit origins — never "*". The /demo page is served by
# this same app and never needs CORS; this is for the widget being embedded
# on a different origin. NOT a production-ready default — set the real
# client portal origin(s) before deploying.
CORS_ALLOWED_ORIGINS=http://localhost:8000
